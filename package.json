{
  "name": "indrive-chauffeur",
  "private": true,
  "version": "1.0.0",
  "description": "Phase 1 public website for a premium chauffeur / private transfer business. React + Node.js/Express + Firebase.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "set-admin": "npm run set-admin --workspace server",
    "preview": "npm run preview --workspace client",
    "test": "npm run test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
